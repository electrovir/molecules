        "sharp": "^0.35.5",
        "url-vir": "^2.2.2",
        "vite": "^8.3.1"
    },
    "devDependencies": {
        "@augment-vir/test": "^32.5.0",
        "@types/node": "^26.6.3",
        "c8": "^12.0.0",
        "istanbul-smart-text-reporter": "^1.1.5",
